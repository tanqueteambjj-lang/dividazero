rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.email is string && data.email.size() <= 256
          && data.displayName is string && data.displayName.size() <= 128
          && data.createdAt is timestamp;
      }

      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) 
        && isValidUser(incoming())
        && incoming().keys().hasAll(['email', 'displayName', 'createdAt'])
        && incoming().keys().size() >= 3 && incoming().keys().size() <= 5;
      
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Debt Rules
    match /debts/{debtId} {
      function isValidDebt(data) {
        return data.userId == request.auth.uid
          && data.title is string && data.title.size() <= 100
          && data.totalAmount is number && data.totalAmount >= 0
          && (data.installmentsCount == null || data.installmentsCount is number)
          && data.status in ['active', 'paid', 'archived']
          && (data.createdAt == null || data.createdAt is timestamp)
          && (data.updatedAt == null || data.updatedAt is timestamp);
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(debtId) && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(debtId)
        && isValidDebt(incoming())
        && incoming().userId == request.auth.uid;
        
      allow update: if isSignedIn() && isValidId(debtId)
        && existing().userId == request.auth.uid
        && isValidDebt(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'totalAmount', 'installmentsCount', 'category', 'status', 'color', 'updatedAt']);
        
      allow delete: if isSignedIn() && isValidId(debtId) && existing().userId == request.auth.uid;
    }

    // Installment Rules
    match /installments/{installmentId} {
      function isValidInstallment(data) {
        return data.userId == request.auth.uid
          && data.debtId is string && data.debtId.size() <= 128
          && data.number is number && data.number > 0
          && data.amount is number && data.amount >= 0
          && data.dueDate is timestamp
          && data.status in ['pending', 'paid', 'overdue'];
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(installmentId) && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(installmentId)
        && isValidInstallment(incoming());
        
      allow update: if isSignedIn() && isValidId(installmentId)
        && existing().userId == request.auth.uid
        && isValidInstallment(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAt', 'amount', 'dueDate']);
        
      allow delete: if isSignedIn() && isValidId(installmentId) && existing().userId == request.auth.uid;
    }

    // User Data Rules
    match /user_data/{userId} {
      function isValidUserData(data) {
        return (data.income == null || data.income is number)
          && (data.updatedAt == null || data.updatedAt is timestamp);
      }

      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId)
        && isValidUserData(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
